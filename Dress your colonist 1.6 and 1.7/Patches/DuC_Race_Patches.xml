<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<Operation Class="PatchOperationSequence">
		<success>Always</success>
		<operations>
			<li Class="PatchOperationTest">
				<xpath>/Defs/ThingDef[thingClass = "Pawn"]/inspectorTabs</xpath>
				<success>Invert</success>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>/Defs/ThingDef[thingClass = "Pawn"]</xpath>
				<value>
					<inspectorTabs/>
				</value>
			</li>
		</operations>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/ThingDef[thingClass = "Pawn"]/inspectorTabs</xpath>
		<value>
          <li>DressUpColonist.DuC_ITab_Pawn_DressUpColonist</li>
		</value>
	</Operation>

	<Operation Class="PatchOperationSequence">
		<success>Always</success>
		<operations>
			<li Class="PatchOperationTest">
				<xpath>/Defs/ThingDef[thingClass = "Pawn"]/comps</xpath>
				<success>Invert</success>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>/Defs/ThingDef[thingClass = "Pawn"]</xpath>
				<value>
					<comps/>
				</value>
			</li>
		</operations>
	</Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[thingClass = "Pawn"]/comps</xpath>
    <value>
      <li Class="DressUpColonist.DuC_CompProperties_DressUpCore">
      </li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[thingClass = "Pawn"]/comps</xpath>
    <value>
      <li Class="DressUpColonist.DuCEx_CompProperties_DressOffset">
      </li>
    </value>
  </Operation>

</Patch>
